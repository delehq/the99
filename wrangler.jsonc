{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the99",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "the99"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the99",
      "database_id": "829b27da-30d1-4fb7-b14f-72737f7e3f43",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "the99-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://the99.99globalict.workers.dev"
  }
}
